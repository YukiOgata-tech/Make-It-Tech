# Resend
RESEND_API_KEY=
RESEND_FROM=          # 自動送信用（no-reply など）
RESEND_FROM_MANUAL=   # 手動送信用（info@ など）
RESEND_TO=

# One-time Firebase-to-Supabase migration scripts only (not required by the site runtime)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_TOOLS_GA_MEASUREMENT_ID=

# Google Analytics Admin API
# Prefer GOOGLE_APPLICATION_CREDENTIALS for local runs.
GA_ADMIN_CLIENT_EMAIL=
GA_ADMIN_PRIVATE_KEY=

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase Auth (admin console)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 再検証トークン（/api/admin/refresh の x-revalidate-token ヘッダに使う）
ADMIN_REVALIDATE_TOKEN=

# Electronic contracts
# 本番は https://sign.make-it-tech.com。未指定時も本番ではこのURLを使用します。
SIGN_SITE_URL=
# WordテンプレートをPDF化する非公開GotenbergのベースURL（例: http://gotenberg:3000）
# Windowsローカル環境では未指定時にインストール済みMicrosoft Wordを使用します。
CONTRACT_PDF_CONVERTER_URL=
# 変換サービスを認証プロキシ配下で運用する場合のみ設定
CONTRACT_PDF_CONVERTER_BEARER_TOKEN=

# Stripe受注・決済リンク（サーバー専用）
# 未指定時はVercel Productionのみlive、それ以外はtest。
STRIPE_MODE=
STRIPE_SECRET_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
# /api/stripe/webhook の署名シークレット。テスト/本番で別の whsec_… を設定。
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_WEBHOOK_SECRET_LIVE=
# 旧構成の単一キー STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET も利用可能。
# 新しいTEST/LIVEキーを設定した場合はWebhookもTEST/LIVE別名を使用する。
# 顧客に案内する自社サイトのURL。ローカル検証では http://localhost:3000
PAYMENT_SITE_URL=https://make-it-tech.com
