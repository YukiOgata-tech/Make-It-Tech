# Resend
RESEND_API_KEY=
RESEND_FROM=          # 自動送信用（no-reply など）
RESEND_FROM_MANUAL=   # 手動送信用（info@ など）
RESEND_TO=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_TOOLS_GA_MEASUREMENT_ID=

# Google Analytics Admin API
# Prefer GOOGLE_APPLICATION_CREDENTIALS for local runs.
GA_ADMIN_CLIENT_EMAIL=
GA_ADMIN_PRIVATE_KEY=

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Admin console access
# ADMIN_VIEW_TOKEN is deprecated (replaced by Firebase Auth session).
ADMIN_VIEW_TOKEN=
ADMIN_ALLOWED_EMAILS=

# 再検証トークン（/api/admin/refresh の x-revalidate-token ヘッダに使う）
ADMIN_REVALIDATE_TOKEN=
