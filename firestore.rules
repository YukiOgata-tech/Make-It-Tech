rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && adminDoc().data.enabled == true;
    }

    // 管理者テーブル（通常はサーバー(Admin SDK)のみ作成/更新）
    match /adminUsers/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 業務診断の回答
    match /intakeResponses/{id} {
      allow read, write: if isAdmin();
    }

    // お知らせ
    match /announcements/{id} {
      allow read, write: if isAdmin();
    }

    // ブログ記事
    match /blogPosts/{id} {
      allow read, write: if isAdmin();
    }

    // 電子契約は機密情報を含むため、管理者もClient SDKから直接操作しない。
    // 管理画面・署名画面ともに、認証済みRoute Handler + Admin SDKを経由する。
    match /contracts/{contractId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    match /contractTokens/{tokenId} {
      allow read, write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    // その他は全て拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
